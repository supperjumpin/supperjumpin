# Copy to .env on the deployment host and set real values.
# Do not commit .env.

POSTGRES_PASSWORD=change-me
SUPPERJUMPIN_ADAPTER_TOKEN=change-me

# Discord developer portal values.
SUPPERJUMPIN_BOT_TOKEN=change-me
SUPPERJUMPIN_BOT_APP_ID=change-me
SUPPERJUMPIN_BOT_GUILD_ID=

# URL that Discord users can open for stored evidence files.
# LAN/Tailscale testing can use http://<host-or-tailscale-name>:9999.
# Real group usage should use a public HTTPS reverse proxy URL.
SUPPERJUMPIN_BOT_EVIDENCE_BASE_URL=http://localhost:9999
SUPPERJUMPIN_BOT_EVIDENCE_PORT=9999

SUPPERJUMPIN_LOG_FORMAT=json
SUPPERJUMPIN_LOG_LEVEL=info
